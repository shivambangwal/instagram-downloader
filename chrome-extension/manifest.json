{
  "manifest_version": 3,
  "name": "Instagram Downloader Local Helper",
  "version": "1.0.0",
  "description": "Send visible Instagram Reel links from the tab you choose to your local downloader.",
  "key": "",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "action": {
    "default_title": "Scan Instagram Reels",
    "default_popup": "popup.html"
  }
}
